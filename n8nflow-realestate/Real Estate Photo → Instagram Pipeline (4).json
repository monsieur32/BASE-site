        "jsCode": "// Kiểm tra xem có dữ liệu callback_query không\nif (!$json.callback_query || !$json.callback_query.data) {\n  return {\n    error: \"Không tìm thấy dữ liệu từ nút bấm Telegram. Hãy thử nhấn nút trên điện thoại!\"\n  };\n}\nconst data = $json.callback_query.data;\nconst [action, approvalId, executionId] = data.split(':');\n\nreturn {\n  action,\n  approvalId, // Bây giờ sẽ là \"approval_174...\"\n  executionId,\n  callbackQueryId: $json.callback_query.id\n};"
