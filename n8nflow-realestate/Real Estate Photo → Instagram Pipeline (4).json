    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a real estate marketing expert and Instagram content creator.\n\nYou have been given a property photo. Your tasks:\n1. Analyze the photo and describe what you see (room type, style, key features, lighting, mood)\n2. Write a compelling Instagram caption (150-200 words) that:\n - Highlights the property's best features\n - Uses real estate marketing language\n - Includes relevant emojis\n - Ends with a call-to-action (e.g., 'DM us for a viewing!')\n - Suggests 15-20 relevant hashtags\n3. Suggest a Canva design style that matches the image mood (e.g., 'Modern Minimal', 'Luxury Gold', 'Warm Cozy')\n\nImage file name: {{ $json.name }}\nImage MIME type: {{ $json.mimeType }}\n\nReturn a JSON object with these exact keys:\n- imageAnalysis: string (detailed description)\n- instagramCaption: string (full caption with hashtags)\n- canvaStyle: string (design style suggestion)\n- propertyType: string (e.g., 'Living Room', 'Kitchen', 'Exterior', 'Bedroom')\n- keyFeatures: array of strings (top 3-5 features spotted)",
        "options": {}
      },
      "name": "AI Photo Analyzer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        672,
        128
      ],
      "id": "681b6477-dc60-45c9-b1d9-5abb63b62f72",
      "typeVersion": 3.1
    },
    {
      "parameters": {
        "jsCode": "// 1. Lấy output từ AI Agent (node ngay phía trước)\nconst inputData = $input.first().json;\nconst rawOutput = inputData.output || inputData.text || '';\n\nlet parsed;\ntry {\n  // Trích xuất JSON từ phản hồi của AI\n  const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : null;\n} catch (e) {\n  parsed = null;\n}\n\n// 2. Dự phòng nếu AI \"ngáo\" không trả JSON\nif (!parsed) {\n  parsed = {\n    imageAnalysis: rawOutput || \"Không thể phân tích\",\n    instagramCaption: \"Mẫu nhà đẹp tại BASE Automation! Liên hệ ngay.\",\n    propertyType: \"Bất động sản\",\n    keyFeatures: []\n  };\n}\n\n// 3. Lấy thông tin file từ node Download Photo \n// LƯU Ý: Bạn phải đảm bảo tên node trong ngoặc đơn khớp 100% với tên trên canvas\nconst fileInfo = $('Download Photo').first().json;\n\nreturn [{\n  json: {\n    ...parsed,\n    fileId: fileInfo.id,\n    fileName: fileInfo.name,\n    fileWebViewLink: fileInfo.webViewLink || '',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        128
      ],
      "id": "291880a8-1fda-4df0-97e5-4f396cb259c1"
    },
    {
      "parameters": {
        "jsCode": "// Store the Canva job ID and all context for the approval step\nconst canvaResponse = $input.first().json;\nconst prevData = $('Parse AI Output').first().json;\n\nreturn [{\n json: {\n canvaJobId: canvaResponse.job?.id || canvaResponse.id || 'pending',\n canvaStatus: canvaResponse.job?.status || canvaResponse.status || 'submitted',\n instagramCaption: prevData.instagramCaption,\n imageAnalysis: prevData.imageAnalysis,\n propertyType: prevData.propertyType,\n keyFeatures: prevData.keyFeatures,\n canvaStyle: prevData.canvaStyle,\n fileName: prevData.fileName,\n fileId: prevData.fileId,\n fileWebViewLink: prevData.fileWebViewLink,\n timestamp: prevData.timestamp,\n executionId: $execution.id,\n approvalId: `approval_${Date.now()}`\n }\n}];"
      },
      "name": "Prepare Approval Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        128
      ],
      "id": "5e44cd19-f83f-4462-a68b-e1d3ee5283c3"
    },
    {
      "parameters": {
        "chatId": "7259103504",
        "text": "=*noti*\n\nProperty Type: {{ $json.propertyType }}\nBrand Style: {{ $json.canvaStyle }}\n\n*AI Analysis:*\n{{ $json.imageAnalysis }}\n\n*Instagram Caption:*\n{{ $json.instagramCaption }}\n\n*Key Features:*\n{{ $json.keyFeatures.join('\\n• ') }}\n\n[View Original Photo]({{ $json.fileWebViewLink }})\n\n*Approval ID:* {{ $json.approvalId }}\n{{  $json.executionId }}\nPlease approve or reject this post:",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approve",
                    "additionalFields": {
                      "callback_data": "=approve:{{ $json.approvalId }}:{{ $json.executionId }}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "=reject:{{ $json.approvalId }}:{{ $json.executionId }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
